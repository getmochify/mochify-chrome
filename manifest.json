{
  "manifest_version": 3,
  "key": "",
  "name": "Mochify: Right-Click Image Converter & Compressor",
  "short_name": "Mochify",
  "version": "1.4.0",
  "description": "Convert any image on the web in one right-click, or describe the edit you want in plain English. Open source, zero retention.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "externally_connectable": {
    "matches": ["https://mochify.app/*"]
  },
  "host_permissions": [
    "https://api.mochify.app/*",
    "https://id.mochify.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
