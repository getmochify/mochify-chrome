{
  "manifest_version": 3,
  "name": "Mochify – AI Image Compression & Optimization",
  "version": "1.2.0",
  "description": "Right‑click any image to resize, convert, and optimize it instantly with Mochify.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "externally_connectable": {
    "matches": ["https://mochify.app/*"]
  },
  "host_permissions": [
    "https://api.mochify.app/*",
    "https://id.mochify.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
